        "parallel": false
      }
    },
    {
      "name": "fault-duplicate",
      "kind": "fault",
      "factory": "support.fixtures.DuplicateCallbackExecutor",
      "capabilities": {
        "inline": true,
        "parallel": false
      }
    }
  ]
}
