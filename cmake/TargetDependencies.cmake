function(ock_write_target_graph output)
  get_property(components GLOBAL PROPERTY OCK_CONTRACT_TARGETS)
  set(rows "")
  foreach(component IN LISTS components)
    string(REPLACE "::" "_" local_name "${component}")
    get_target_property(links ock_${local_name} INTERFACE_LINK_LIBRARIES)
    if(NOT links)
      set(links "")
    endif()
    get_target_property(stage ock_${local_name} OCK_IMPLEMENTATION_STAGE)
    get_target_property(features ock_${local_name} INTERFACE_COMPILE_FEATURES)
    get_target_property(options ock_${local_name} INTERFACE_COMPILE_OPTIONS)
    list(JOIN features "\",\"" features_json)
    list(JOIN options "\",\"" options_json)
    set(dependencies "")
    foreach(link IN LISTS links)
      string(REGEX REPLACE "^OCK::" "" dependency "${link}")
      list(APPEND dependencies "\"${dependency}\"")
    endforeach()
    list(JOIN dependencies "," dependencies_json)
    list(APPEND rows "\"${component}\": {\"dependencies\": [${dependencies_json}], \"implementation\": \"${stage}\", \"compile_features\": [\"${features_json}\"], \"compile_options\": [\"${options_json}\"]}")
  endforeach()
  list(JOIN rows ",\n" rows_json)
  file(WRITE "${output}" "{\n\"format\":\"ock.cmake-target-graph/1\",\n\"targets\":{\n${rows_json}\n}}\n")
endfunction()
