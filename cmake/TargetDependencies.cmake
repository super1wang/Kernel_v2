# D0.02：真实可导出的合同目标。没有任何 Runtime/后端实现。
function(ock_contract_target component include_root)
  string(REPLACE "::" "_" local_name "${component}")
  set(target "ock_${local_name}")
  add_library(${target} INTERFACE)
  add_library(OCK::${component} ALIAS ${target})
  set_target_properties(${target} PROPERTIES EXPORT_NAME "${component}" OCK_IMPLEMENTATION_STAGE ContractBaseline EXPORT_PROPERTIES OCK_IMPLEMENTATION_STAGE)
  target_compile_features(${target} INTERFACE cxx_std_20)
  target_compile_options(${target} INTERFACE "$<$<CXX_COMPILER_ID:MSVC>:/utf-8>")
  target_include_directories(${target} INTERFACE "$<BUILD_INTERFACE:${PROJECT_SOURCE_DIR}/${include_root}>" "$<INSTALL_INTERFACE:include>")
  foreach(dep IN LISTS ARGN)
    target_link_libraries(${target} INTERFACE OCK::${dep})
  endforeach()
  set_property(GLOBAL APPEND PROPERTY OCK_CONTRACT_TARGETS "${component}")
  install(TARGETS ${target} EXPORT OCKTargets)
endfunction()

