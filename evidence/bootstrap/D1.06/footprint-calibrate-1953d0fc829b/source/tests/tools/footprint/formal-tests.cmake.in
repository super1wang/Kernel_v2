string(RANDOM LENGTH 24 ALPHABET "0123456789abcdef" _footprint_run)
if(CTEST_CONFIGURATION_TYPE STREQUAL "Debug" AND NOT @OCK_ENABLE_ASAN@)
  foreach(_case method_identity module_accounting memory_calibration thread_clock_calibration phase_repetition owned_process raw_integrity budget_provenance)
    add_test("T23.footprint.${_case}" "@Python3_EXECUTABLE@" -X utf8 "@PROJECT_SOURCE_DIR@/tools/footprint/method_checks.py"
      --case "${_case}" --fixture "@CMAKE_BINARY_DIR@/footprint-method/${_footprint_run}")
    set_tests_properties("T23.footprint.${_case}" PROPERTIES TIMEOUT 900 WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@")
    if(_case STREQUAL "method_identity")
      set_tests_properties("T23.footprint.${_case}" PROPERTIES FIXTURES_SETUP footprint_method)
    else()
      set_tests_properties("T23.footprint.${_case}" PROPERTIES FIXTURES_REQUIRED footprint_method)
    endif()
  endforeach()
endif()
set(_footprint_profile win-msvc-debug)
if(@OCK_ENABLE_ASAN@)
  set(_footprint_profile win-msvc-asan)
elseif(CTEST_CONFIGURATION_TYPE STREQUAL "Release")
  set(_footprint_profile win-msvc-release)
endif()
foreach(_mode occupancy allocation latency)
  if(_mode STREQUAL "latency" AND NOT _footprint_profile STREQUAL "win-msvc-release")
    continue()
  endif()
  if(_mode STREQUAL "occupancy")
    set(_case native_occupancy)
  elseif(_mode STREQUAL "allocation")
    set(_case allocation_report)
  else()
    set(_case ready_latency)
  endif()
  add_test("T23.footprint.${_case}" "@Python3_EXECUTABLE@" -X utf8 "@PROJECT_SOURCE_DIR@/tools/footprint/formal.py"
    --profile "${_footprint_profile}" --mode "${_mode}" --build "@CMAKE_BINARY_DIR@")
  set_tests_properties("T23.footprint.${_case}" PROPERTIES TIMEOUT 900 RUN_SERIAL TRUE WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@")
endforeach()
