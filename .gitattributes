# E03 fingerprints the bytes actually read by the compiler and collectors.
# Preserve those bytes in Git; writers choose line endings explicitly.
* -text whitespace=cr-at-eol

# Preserve intentional Markdown hard breaks in the supplied normative documents.
docs/01_Architecture_v3.3.md whitespace=-blank-at-eol
docs/02_Execution_Plan_v3.3.md whitespace=-blank-at-eol

# Raw process evidence is byte-exact; never normalize captured streams.
/evidence/bootstrap/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

/evidence/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof

/THIRD_PARTY_NOTICES whitespace=-blank-at-eol
