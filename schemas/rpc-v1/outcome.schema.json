{
"$schema":"https://json-schema.org/draft/2020-12/schema",
"$id":"urn:ock:rpc:outcome:1",
"$comment":"D2.04 生产 wire；强类型身份、完整原子域、结构化错误。跨事实真实性与历史追加由 CoreContracts/owner 验证。",
"title":"OCK InvokeReply and Outcome wire",
"oneOf":[{"$ref":"#/$defs/completed"},{"$ref":"#/$defs/rejected"}],
"$defs":{
"CommitFact":{"type":"object","properties":{"kind":{"const":"CommitFact"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"commit_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"domain":{"$ref":"#/$defs/domain"},"revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"durability":{"enum":["Memory","DurableCommitted"]}},"required":["kind","fact_id","commit_id","domain","revision","durability"],"additionalProperties":false},
"PublishedFact":{"type":"object","properties":{"kind":{"const":"PublishedFact"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"commit_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"published_version":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"}},"required":["kind","fact_id","commit_id","published_version"],"additionalProperties":false},
"EffectFact":{"type":"object","properties":{"kind":{"const":"EffectFact"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"effect_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"application":{"enum":["NotApplied","Applied","PartiallyApplied"]}},"required":["kind","fact_id","effect_id","application"],"additionalProperties":false},
"LifecycleFact":{"type":"object","properties":{"kind":{"const":"LifecycleFact"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"transition_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"before":{"type":"string","minLength":1},"after":{"type":"string","minLength":1},"generation":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"}},"required":["kind","fact_id","transition_id","before","after","generation"],"additionalProperties":false},
"UnknownFact":{"type":"object","properties":{"kind":{"const":"UnknownFact"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"boundary":{"enum":["ExternalEffect","StorageCommit"]},"reference_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"reconcile":{"type":"string","minLength":1}},"required":["kind","fact_id","boundary","reference_id","reconcile"],"additionalProperties":false},
"ResolutionRecord":{"type":"object","properties":{"kind":{"const":"ResolutionRecord"},"fact_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"unknown_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"determination":{"enum":["NotApplied","Applied","PartiallyApplied"]},"evidence_ref":{"type":"string","minLength":1}},"required":["kind","fact_id","unknown_id","determination","evidence_ref"],"additionalProperties":false},
"known_fact":{"oneOf":[{"$ref":"#/$defs/CommitFact"},{"$ref":"#/$defs/PublishedFact"},{"$ref":"#/$defs/EffectFact"},{"$ref":"#/$defs/LifecycleFact"},{"$ref":"#/$defs/UnknownFact"},{"$ref":"#/$defs/ResolutionRecord"}]},
"ReadCompleted":{"type":"object","properties":{"kind":{"const":"ReadCompleted"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"result":{},"result_scope":{"enum":["ReadOnly","Candidate"]},"conditions":{"$ref":"#/$defs/conditions"},"result_error":{"$ref":"#/$defs/error"}},"required":["kind","evidence","known_facts","result_scope","conditions"],"additionalProperties":false,"oneOf":[{"required":["result"],"not":{"required":["result_error"]}},{"required":["result_error"],"not":{"required":["result"]}}]},
"StateCommitted":{"type":"object","properties":{"kind":{"const":"StateCommitted"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"commit_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"domain":{"$ref":"#/$defs/domain"},"revision":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"published_version":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"result":{},"conditions":{"$ref":"#/$defs/conditions"},"result_error":{"$ref":"#/$defs/error"}},"required":["kind","evidence","known_facts","commit_id","domain","revision","published_version","conditions"],"additionalProperties":false,"oneOf":[{"required":["result"],"not":{"required":["result_error"]}},{"required":["result_error"],"not":{"required":["result"]}}]},
"EffectResolved":{"type":"object","properties":{"kind":{"const":"EffectResolved"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"effect_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"application":{"enum":["NotApplied","Applied","PartiallyApplied"]},"status":{"enum":["Succeeded","Failed"]},"external_evidence":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"result":{},"result_error":{"$ref":"#/$defs/error"},"conditions":{"$ref":"#/$defs/conditions"},"reconcile":{"type":"string"}},"required":["kind","evidence","known_facts","effect_id","application","status","external_evidence","conditions","reconcile"],"additionalProperties":false,"anyOf":[{"required":["result"]},{"required":["result_error"]}],"oneOf":[{"required":["result"],"not":{"required":["result_error"]}},{"required":["result_error"],"not":{"required":["result"]}}]},
"LifecycleResolved":{"type":"object","properties":{"kind":{"const":"LifecycleResolved"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"transition_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"before":{"type":"string","minLength":1},"after":{"type":"string","minLength":1},"generation":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"status":{"enum":["Succeeded","Failed"]},"result":{},"conditions":{"$ref":"#/$defs/conditions"},"result_error":{"$ref":"#/$defs/error"},"target":{"type":"string","pattern":"^[0-9a-f]{32}$"}},"required":["kind","evidence","known_facts","transition_id","before","after","generation","status","conditions","target"],"additionalProperties":false,"oneOf":[{"required":["result"],"not":{"required":["result_error"]}},{"required":["result_error"],"not":{"required":["result"]}}]},
"PlanCompleted":{"type":"object","properties":{"kind":{"const":"PlanCompleted"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"exports":{"type":"object"},"steps":{"type":"array","items":{"type":"object","properties":{"step_id":{"type":"string","minLength":1},"status":{"enum":["Succeeded","Failed","Cancelled"]},"actual":{"enum":["Succeeded","Failed","Unknown"]},"required":{"type":"boolean"},"finalized":{"type":"boolean"}},"required":["step_id","status","actual","required","finalized"],"additionalProperties":false}},"conditions":{"$ref":"#/$defs/conditions"},"exports_error":{"$ref":"#/$defs/error"}},"required":["kind","evidence","known_facts","steps","conditions"],"additionalProperties":false,"oneOf":[{"required":["exports"],"not":{"required":["exports_error"]}},{"required":["exports_error"],"not":{"required":["exports"]}}]},
"FailedBeforeApply":{"type":"object","properties":{"kind":{"const":"FailedBeforeApply"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"failure_phase":{"type":"string","minLength":1},"reason":{"$ref":"#/$defs/error"},"proof":{"const":"NoAppliedStateOrEffect"},"conditions":{"$ref":"#/$defs/conditions"}},"required":["kind","evidence","known_facts","failure_phase","reason","proof","conditions"],"additionalProperties":false},
"CancelledBeforeApply":{"type":"object","properties":{"kind":{"const":"CancelledBeforeApply"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"reason":{"$ref":"#/$defs/error"},"proof":{"const":"NoAppliedStateOrEffect"},"conditions":{"$ref":"#/$defs/conditions"}},"required":["kind","evidence","known_facts","reason","proof","conditions"],"additionalProperties":false},
"PartialCompletion":{"type":"object","properties":{"kind":{"const":"PartialCompletion"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"steps":{"type":"array","minItems":1,"items":{"type":"object","properties":{"step_id":{"type":"string","minLength":1},"status":{"enum":["Succeeded","Failed","Cancelled"]},"actual":{"enum":["Succeeded","Failed","Unknown"]},"required":{"type":"boolean"},"finalized":{"type":"boolean"}},"required":["step_id","status","actual","required","finalized"],"additionalProperties":false}},"conditions":{"$ref":"#/$defs/conditions"}},"required":["kind","evidence","known_facts","steps","conditions"],"additionalProperties":false},
"Indeterminate":{"type":"object","properties":{"kind":{"const":"Indeterminate"},"evidence":{"enum":["Volatile","Durable","RequiredRecordFailed","PersistenceUncertain"]},"known_facts":{"type":"array","items":{"$ref":"#/$defs/known_fact"}},"unknown_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"conditions":{"$ref":"#/$defs/conditions"}},"required":["kind","evidence","known_facts","unknown_ids","conditions"],"additionalProperties":false},
"outcome":{"oneOf":[{"$ref":"#/$defs/ReadCompleted"},{"$ref":"#/$defs/StateCommitted"},{"$ref":"#/$defs/EffectResolved"},{"$ref":"#/$defs/LifecycleResolved"},{"$ref":"#/$defs/PlanCompleted"},{"$ref":"#/$defs/FailedBeforeApply"},{"$ref":"#/$defs/CancelledBeforeApply"},{"$ref":"#/$defs/PartialCompletion"},{"$ref":"#/$defs/Indeterminate"}]},
"rejected":{"type":"object","properties":{"kind":{"const":"Rejected"},"reason":{"$ref":"#/$defs/error"}},"required":["kind","reason"],"additionalProperties":false},
"completed":{"type":"object","properties":{"kind":{"const":"Completed"},"outcome":{"$ref":"#/$defs/outcome"}},"required":["kind","outcome"],"additionalProperties":false},
"error":{"type":"object","properties":{"domain":{"type":"string","minLength":1},"code":{"type":"integer","minimum":0,"maximum":4294967295},"message":{"type":"string"}},"required":["domain","code"],"additionalProperties":false},
"domain":{"type":"object","properties":{"provider":{"type":"string","minLength":1},"domain_id":{"type":"string","pattern":"^[0-9a-f]{32}$"},"generation":{"type":"string","pattern":"^[0-9a-f]{32}$"}},"required":["provider","domain_id","generation"],"additionalProperties":false},
"conditions":{"type":"object","properties":{"record_state":{"enum":["NotRequired","Pending","Recorded","Failed"]},"local_work_remaining":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"required_children_unsettled":{"type":"string","pattern":"^(0|[1-9][0-9]{0,19})$"},"before_apply":{"type":"object","properties":{"business_entered":{"type":"boolean"},"execution_accepted":{"type":"boolean"},"decision":{"enum":["NotReached","CancelWon","ClaimWon"]},"no_application_proven":{"type":"boolean"}},"required":["business_entered","decision","no_application_proven"],"additionalProperties":false},"record_error":{"$ref":"#/$defs/error"},"writes_blocked":{"type":"boolean"},"repair":{"enum":["CommitLedger","ReceiptReconcile","ManualReview"]}},"required":["record_state","local_work_remaining","required_children_unsettled"],"additionalProperties":false}
}
}
