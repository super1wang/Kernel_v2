{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "const": "ock.command-card/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "contract_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "atomic_mode": {
      "enum": [
        "Incompatible",
        "PureCompute",
        "CandidateRead",
        "StateEdit"
      ]
    },
    "installed": {
      "const": true
    },
    "visible": {
      "const": true
    },
    "eligible": {
      "type": "boolean"
    },
    "required_permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "args_schema": {
      "type": "object"
    },
    "result_schema": {
      "type": "object"
    },
    "docs": {
      "type": "object",
      "properties": {
        "format": {
          "const": "ock.command-docs/1"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "coordinates": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "position_mode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "impact_scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "id_sources": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "cancellation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "durability": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "result_phases": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "error_repair": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "counterexamples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "retry": {
          "type": "object",
          "properties": {
            "natural_idempotence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "framework_deduplication": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "device_deduplication": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          },
          "required": [
            "natural_idempotence",
            "framework_deduplication",
            "device_deduplication"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format",
        "purpose",
        "coordinates",
        "position_mode",
        "impact_scope",
        "id_sources",
        "cancellation",
        "durability",
        "result_phases",
        "error_repair",
        "counterexamples",
        "retry"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "name",
    "version",
    "contract_digest",
    "atomic_mode",
    "installed",
    "visible",
    "eligible",
    "required_permissions",
    "args_schema",
    "result_schema",
    "docs"
  ],
  "additionalProperties": false
}
